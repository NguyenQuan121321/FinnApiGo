# ============================================================
# FinnApiGo — environment configuration example
# Copy to ".env" and adjust values. NEVER commit a real .env.
# Every variable below is read by internal/config — nothing here is dead.
# ============================================================

# --- Server ---
SERVER_PORT=8080
GIN_MODE=debug               # debug | release | test
# Comma-separated CIDRs/IPs allowed to set X-Forwarded-For / X-Real-IP
# (your LB, Cloudflare, Nginx). Empty = trust nobody (spoof-proof default).
# TRUSTED_PROXIES=
# Starts a pprof listener (internal addresses only — never expose it).
# PPROF_ADDR=127.0.0.1:6060
# Comma-separated browser origins allowed to call the API cross-origin.
# Empty = no CORS behavior (native clients unaffected).
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Strict-Transport-Security max-age on HTTPS responses (0 = off).
# HSTS_SECONDS=31536000
# --- Swagger UI ---
# Mounts the swag-generated interactive docs at /swagger/index.html.
# Defaults to false at runtime (secure-by-default); this example file turns
# it on for local development. Keep it off in production.
SWAGGER_ENABLED=true

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=finnapigo
DB_PASSWORD=change-me-strong-db-password
DB_NAME=finnapigo
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
# TLS for the DB connection: "true" (verify CA) | "skip-verify" | "preferred" | "" (off, dev only)
# DB_TLS=true
# DEV-ONLY escape hatch: GORM AutoMigrate at boot. Production MUST use
# cmd/migrate (Render release command) — never set this to true there.
# MIGRATE_AUTO=false

# --- JWT ---
# IMPORTANT: override JWT_SECRET with a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=finnapigo
# Previous secret during a key rotation (K2): old-kid tokens keep verifying
# while this is set. Remove it once all pre-rotation tokens have expired —
# acceptance is bounded by each token's own expiry, not by a separate timer.
# JWT_SECRET_PREVIOUS=

# --- Token lifetimes ( durations ) ---
ACCESS_TOKEN_TTL=15m          # short-lived access token
REFRESH_TOKEN_TTL=168h        # 7 days
RESET_TOKEN_TTL=15m           # password-reset token lifetime
EMAIL_VERIFY_TOKEN_TTL=24h    # email verification token lifetime
MFA_PENDING_TOKEN_TTL=5m      # pending-login token issued while MFA is unsatisfied
SUDO_TOKEN_TTL=15m            # sudo window after TOTP-verified recovery-code viewing

# --- Account security ---
MAX_LOGIN_ATTEMPTS=5          # failed logins before lockout
LOGIN_LOCKOUT_DURATION=15m   # how long the account stays locked
MAX_LOCKOUT_MULTIPLIER=4     # cap for exponential backoff (base × min(lockoutCount, this)); 0 disables scaling
REQUIRE_EMAIL_VERIFIED=false  # gate login behind is_email_verified (policy decision — default off)
# Transparency alert: email the user on the first login from a previously
# unseen IP. Deliberately NOT risk-based auth — no step-up, no blocking.
LOGIN_NOTIFY_NEW_IP=true

# --- MFA / TOTP ---
TOTP_MAX_ATTEMPTS=5           # failed TOTP validates before 429 lockout
TOTP_ATTEMPT_WINDOW=5m        # sliding window for TOTP_MAX_ATTEMPTS
RECOVERY_CODE_COUNT=10        # recovery codes issued per set (GitHub-style)
RECOVERY_CODE_BYTES=16        # entropy per code before hex encoding (16 => 128-bit)
# AES-256 key (64 hex chars) sealing the re-viewable recovery-code copies.
# Empty = derived from JWT_SECRET; rotating either orphans saved codes
# (users regenerate). REQUIRED in release mode — configure a dedicated key.
RECOVERY_CODE_KEY=

# --- Rate limiting ---
RATE_LIMIT_RPS=5              # requests per second per IP on sensitive endpoints
RATE_LIMIT_BURST=10
LOGIN_PER_ACCOUNT_MAX=10      # max login attempts per email within LOGIN_WINDOW
LOGIN_WINDOW=1m               # per-account login rate-limit window
REGISTER_PER_IP_MAX=5         # max registrations per IP within REGISTER_WINDOW
REGISTER_WINDOW=1h            # registration velocity-limit window
VERIFY_RESEND_PER_EMAIL_MAX=3 # max verification-email resends per email
VERIFY_RESEND_WINDOW=1h       # per-email resend rate-limit window
VERIFY_RESEND_PER_IP_MAX=5    # shared-store cap per source IP
VERIFY_RESEND_PER_IP_WINDOW=1h
VERIFY_RESEND_GLOBAL_MAX=100  # shared global circuit-breaker for resends
VERIFY_RESEND_GLOBAL_WINDOW=1h
LOGIN_CAPTCHA_AFTER_FAILS=5  # after this many failed logins from one IP, require CAPTCHA

# --- Hardening ---
MAX_REQUEST_BODY_BYTES=1048576  # global body-size cap in bytes (default 1 MiB)
MAX_PASSWORD_LENGTH=72         # bcrypt maximum; longer inputs are rejected
RATE_LIMITER_ENTRY_TTL=5m      # per-IP rate-limiter map entry TTL
TOTP_MAX_CONCURRENT=64         # cap on concurrent CPU-bound TOTP validations (0 disables)
# Screen new passwords against the Pwned Passwords corpus (k-anonymity:
# only a 5-hex-char SHA-1 prefix leaves the process). FAILS OPEN on outage.
BREACHED_PASSWORD_CHECK=true
BREACHED_PASSWORD_TIMEOUT=5s

# --- CAPTCHA (optional) ---
# Empty CAPTCHA_PROVIDER disables CAPTCHA verification entirely.
CAPTCHA_PROVIDER=              # "turnstile" | "hcaptcha" | "" (= off)
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# --- Google OAuth 2.0 / OpenID Connect (optional) ---
# "Sign in with Google" (PKCE S256 + nonce + browser-bound state).
# Leave GOOGLE_CLIENT_ID empty to disable the /api/v1/auth/google/* endpoints
# entirely (they are not registered). Redirect URL must match exactly what is
# configured in Google Cloud Console,
# e.g. http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# --- Redis (optional) ---
# Set to a redis:// URL to use RedisStore for shared rate-limit counters
# and single-use-token state across instances. Empty = in-memory store.
# NOTE: with REDIS_URL set, Redis is on the critical path for refresh-token
# rotation, MFA replay guards, and OAuth state (guards fail CLOSED); only
# throttle counters fail OPEN. Size and monitor it accordingly.
REDIS_URL=

# --- Email (SMTP). Leave empty to log to console instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@finnapigo.local

# --- Audit (async writer, flushed on shutdown) ---
AUDIT_BUFFER_SIZE=1024
AUDIT_FLUSH_BATCH=64
# PII retention window for audit rows (email, IP) in days. 0 (default) keeps
# history forever — release mode warns about the governance implication.
# AUDIT_RETENTION_DAYS=180

# --- Background jobs (S2) ---
# Unset = leader election via the shared store (one replica runs cleanup).
# true = this replica runs jobs unconditionally (pin to exactly ONE replica).
# false = jobs disabled on this replica.
# RUN_JOBS=true

# --- Metrics exposure (X1) ---
# Set to move /metrics OFF the public router onto an internal listener.
# METRICS_ADDR=127.0.0.1:9090
# Optional bearer token on the internal metrics listener.
# METRICS_TOKEN=

# --- Key management (K3) ---
# "env" (default) reads keys from environment variables; "file" reads hex
# <name>.key files (jwt, jwt_previous, recovery_codes) from KEY_DIR.
# KEY_PROVIDER=env
# KEY_DIR=./keys

# --- Distributed tracing (O1) ---
# Unset = no-op tracer (zero export overhead).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Passkeys / WebAuthn (Phase 9) ---
# Unset RPID = passkey endpoints disabled entirely.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_ORIGINS=https://example.com
# WEBAUTHN_RP_DISPLAY_NAME=FinnApiGo
# WEBAUTHN_ATTESTATION=none
